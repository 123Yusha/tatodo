{
  "cli": {
    "version": ">= 14.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "iospreview": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "iospreview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "yr130488@googlemail.com",
        "ascAppId": "6741329271",
        "appleTeamId": "RXYGW282H3"
      }
    }
  }
}
