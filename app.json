{
  "expo": {
    "name": "tatodo",
    "slug": "tatodo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tatodo-landing.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "This app requires access to your calendar to add events.",
        "NSRemindersUsageDescription": "This app requires access to your reminders to schedule events.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.123yusha.tatodo"
    },
    "android": {
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tatodo-landing.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yusha123.tatodo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/tatodo-landing.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tatodo-landing.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "60aeb724-8373-4d5e-89e7-2252a8e99c2e"
      }
    },
    "owner": "123yusha"
  }
}
